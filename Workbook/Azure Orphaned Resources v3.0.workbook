g(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/serviceendpointpolicies\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.subnets) or array_length(properties.subnets) == 0\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Service endpoint policy is not associated with any subnet\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; Service Endpoint Policies do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    ResourceContainers\n    | where type =~ \"microsoft.resources/subscriptions/resourcegroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend rgAndSub=strcat(resourceGroup, \"--\", subscriptionId)\n    | join kind=leftouter (\n        resources\n        | extend rgAndSub=strcat(resourceGroup, \"--\", subscriptionId)\n        | summarize resourceCount=count() by rgAndSub\n    ) on rgAndSub\n    | where isnull(resourceCount)\n    | extend Category=\"Other\", Resource=id, ResourceName=resourceGroup, ResourceType=tolower(type),\n        OrphanReason=\"Resource group contains no visible or hidden resources\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; empty resource groups do not carry direct resource cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.web/connections\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | project Resource=id, ResourceName=name, subscriptionId, resourceGroup, tags, location, ResourceType=tolower(type), Details=pack_all()\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.logic/workflows\"\n        | extend var_json=properties[\"parameters\"][\"$connections\"][\"value\"]\n        | mv-expand var_connection=var_json\n        | where notnull(var_connection)\n        | extend connectionId=extract(\"connectionId\\\\\\\":\\\\\\\"(.*?)\\\\\\\"\", 1, tostring(var_connection))\n        | project connectionId\n    ) on $left.Resource == $right.connectionId\n    | where isempty(connectionId)\n    | extend Category=\"Other\",\n        OrphanReason=\"API connection is not referenced by Logic App workflow connection parameters\",\n        CostBearing=\"Review\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Review connector-specific billing before assigning savings\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\" \n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.web/certificates\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend expiresOn=todatetime(properties.expirationDate)\n    | where expiresOn <= now()\n    | extend Category=\"Other\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=strcat(\"Certificate expired on \", format_datetime(expiresOn, \"yyyy-MM-dd\")),\n        CostBearing=\"Review\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Review certificate SKU and renewal/billing model before assigning savings\",\n        OrphanConfidence=\"High\", ResourceAgeDays=datetime_diff(\"day\", now(), expiresOn),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n);OrphanResources\n| extend AzurePortalLink=strcat(\"https://portal.azure.com/#@/resource\", Resource)\n| summarize Count=count() by OrphanConfidence | order by Count desc",
              "size": 3,
              "title": "Resources by orphan confidence",
              "noDataMessage": "No results.",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "piechart"
            },
            "name": "query - Orphans by Confidence",
            "customWidth": "33"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let OrphanResources = union isfuzzy=true\n(\n    resources\n    | where type =~ \"microsoft.web/serverfarms\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.numberOfSites == 0\n    | extend Category=\"Compute\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"App Service plan has zero hosted apps\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; ARG does not expose actual billed cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(sku.tier), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.compute/availabilitysets\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where (isnull(properties.virtualMachines) or array_length(properties.virtualMachines) == 0)\n    | where not(name endswith \"-asr\")\n    | extend Category=\"Compute\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Availability set has no associated VMs and is not ASR generated\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; no direct standalone compute charge\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.compute/disks\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend diskState = tostring(properties.diskState)\n    | where (managedBy == \"\" and diskState != \"ActiveSAS\") or (diskState == \"Unattached\" and diskState != \"ActiveSAS\")\n    | where not(name endswith \"-ASRReplica\" or name startswith \"ms-asr-\" or name startswith \"asrseeddisk-\")\n    | where (tags !contains \"kubernetes.io-created-for-pvc\") and tags !contains \"ASR-ReplicaDisk\" and tags !contains \"asrseeddisk\" and tags !contains \"RSVaultBackup\"\n    | extend Category=\"Storage\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=strcat(\"Managed disk is \", diskState, \" and has no managedBy VM reference; ASR/AKS/backup patterns excluded\"),\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; join with Cost Management or pricing by region/SKU/size\",\n        OrphanConfidence=\"High\", ResourceAgeDays=datetime_diff(\"day\", now(), todatetime(properties.timeCreated)),\n        SKU=tostring(sku.name), Tier=strcat(\"SizeGB=\", tostring(properties.diskSizeGB)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.sql/servers/elasticpools\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | project elasticPoolId=tolower(id), Resource=id, ResourceName=name, ResourceType=tolower(type), resourceGroup, location, subscriptionId, tags, sku, Details=pack_all()\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.sql/servers/databases\"\n        | project databaseId=id, elasticPoolId=tolower(properties.elasticPoolId)\n    ) on elasticPoolId\n    | summarize databaseCount=countif(isnotempty(databaseId)), Details=any(Details), tags=any(tags), SKU=any(tostring(sku.name)), Tier=any(tostring(sku.tier)) by subscriptionId, resourceGroup, location, Resource, ResourceName, ResourceType\n    | where databaseCount == 0\n    | extend Category=\"Database\", OrphanReason=\"SQL elastic pool has no databases\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; ARG does not expose actual billed cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\")\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/publicipaddresses\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.ipConfiguration == \"\" and properties.natGateway == \"\" and properties.publicIPPrefix == \"\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Public IP has no IP configuration, NAT gateway, or public IP prefix association\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on SKU, allocation, region, and usage\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(properties.publicIPAllocationMethod), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/networkinterfaces\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.privateEndpoint)\n    | where isnull(properties.privateLinkService)\n    | where properties.hostedWorkloads == \"[]\"\n    | where properties !has \"virtualmachine\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Network interface has no VM, private endpoint, private link service, or hosted workload association\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; NICs normally do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=tostring(kind), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/networksecuritygroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.networkInterfaces) and isnull(properties.subnets)\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Network security group is not associated with any NIC or subnet\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; no direct standalone NSG charge\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/routetables\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.subnets)\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Route table is not associated with any subnet\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; no direct standalone route table charge\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/loadbalancers\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.backendAddressPools == \"[]\" and properties.inboundNatRules == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Load balancer has no backend pools and no inbound NAT rules\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate for Standard/Gateway tiers; validate actual Cost Management charges\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(sku.tier), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/frontdoorwebapplicationfirewallpolicies\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.securityPolicyLinks == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Front Door WAF policy has no security policy links\",\n        CostBearing=\"Review\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Review billing and Front Door associations before assigning savings\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(sku.tier), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/trafficmanagerprofiles\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.endpoints == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Traffic Manager profile has no endpoints\",\n        CostBearing=\"Review\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Review DNS/query charges before assigning savings\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/applicationgateways\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend AppGwId=tostring(id), SKU=tostring(properties.sku.name), Tier=tostring(properties.sku.tier), Details=pack_all()\n    | project AppGwId, ResourceName=name, resourceGroup, location, subscriptionId, tags, ResourceType=tolower(type), SKU, Tier, Details\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.network/applicationgateways\"\n        | mv-expand backendPools=properties.backendAddressPools\n        | extend AppGwId=tostring(id), backendIPCount=array_length(backendPools.properties.backendIPConfigurations), backendAddressesCount=array_length(backendPools.properties.backendAddresses)\n        | summarize backendIPCount=sum(backendIPCount), backendAddressesCount=sum(backendAddressesCount) by AppGwId\n    ) on AppGwId\n    | where (backendIPCount == 0 or isempty(backendIPCount)) and (backendAddressesCount == 0 or isempty(backendAddressesCount))\n    | extend Category=\"Networking\", Resource=AppGwId,\n        OrphanReason=\"Application gateway backend pools contain no backend IP configurations or backend addresses\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on SKU, capacity, region, and usage\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\")\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/virtualnetworks\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.subnets == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Virtual network has no subnets\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; VNets do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/virtualnetworks\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | mv-expand subnet=properties.subnets\n    | extend ipConfigurations=subnet.properties.ipConfigurations, delegations=subnet.properties.delegations, applicationGatewayIPConfigurations=subnet.properties.applicationGatewayIPConfigurations\n    | where isnull(ipConfigurations) and delegations == \"[]\" and isnull(applicationGatewayIPConfigurations)\n    | extend Category=\"Networking\", Resource=tostring(subnet.id), ResourceName=strcat(name, \"/\", tostring(subnet.name)), ResourceType=\"microsoft.network/virtualnetworks/subnets\",\n        OrphanReason=\"Subnet has no connected devices, delegations, or application gateway IP configurations\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; subnets do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", tags=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags, Details\n\n),\n(\n    resources\n    | where type =~ \"microsoft.network/natgateways\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.subnets)\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"NAT gateway is not associated with any subnet\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on region and processed data\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(sku.tier), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/ipgroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.firewalls == \"[]\" and properties.firewallPolicies == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"IP group is not referenced by Azure Firewall or Firewall Policy\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; no direct standalone IP Group charge\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/privatednszones\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.numberOfVirtualNetworkLinks == 0\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Private DNS zone has zero virtual network links\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on zone and query/record activity\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=strcat(\"RecordSets=\", tostring(properties.numberOfRecordSets)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/privateendpoints\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend connection=iff(array_length(properties.manualPrivateLinkServiceConnections) > 0, properties.manualPrivateLinkServiceConnections[0], properties.privateLinkServiceConnections[0])\n    | extend stateEnum=tostring(connection.properties.privateLinkServiceConnectionState.status)\n    | where stateEnum == \"Disconnected\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Private endpoint connection state is Disconnected\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; validate connection state and actual billed cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=tostring(connection.properties.groupIds[0]), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/virtualnetworkgateways\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend Resource=id, ResourceName=name, ResourceType=tolower(type), SKU=tostring(properties.sku.name), Tier=tostring(properties.sku.tier), GatewayType=tostring(properties.gatewayType), vpnClientConfiguration=properties.vpnClientConfiguration, Details=pack_all()\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.network/connections\"\n        | mv-expand Resource=pack_array(properties.virtualNetworkGateway1.id, properties.virtualNetworkGateway2.id) to typeof(string)\n        | project Resource, connectionId=id\n    ) on Resource\n    | where isempty(vpnClientConfiguration) and isempty(connectionId)\n    | extend Category=\"Networking\",\n        OrphanReason=\"Virtual network gateway has no point-to-site configuration and no gateway connections\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on gateway SKU, region, and runtime\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        Tier=strcat(Tier, \"; \", GatewayType)\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/ddosprotectionplans\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.virtualNetworks)\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"DDoS protection plan has no associated virtual networks\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; validate actual plan charges in Cost Management\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.compute/snapshots\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isempty(managedBy)\n    | where not(name startswith \"sigs-\" or name startswith \"sigs_\")\n    | extend Category=\"Storage\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Snapshot has no managedBy relationship; review retention policy before deleting\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct storage cost candidate; validate size, SKU, region, and retention requirements in Cost Management\",\n        OrphanConfidence=\"Review Required\", ResourceAgeDays=datetime_diff(\"day\", now(), todatetime(properties.timeCreated)),\n        SKU=tostring(sku.name), Tier=strcat(\"SizeGB=\", tostring(properties.diskSizeGB)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/virtualnetworks\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where array_length(properties.virtualNetworkPeerings) > 0\n    | mv-expand peering=properties.virtualNetworkPeerings\n    | extend peeringState=tostring(peering.properties.peeringState), remoteVirtualNetwork=tostring(peering.properties.remoteVirtualNetwork.id)\n    | where peeringState !~ \"Connected\"\n    | where id < remoteVirtualNetwork\n    | extend Category=\"Networking\", Resource=tostring(peering.id), ResourceName=strcat(name, \"/\", tostring(peering.name)), ResourceType=\"microsoft.network/virtualnetworks/virtualnetworkpeerings\",\n        OrphanReason=strcat(\"VNet peering is not connected; current state is \", peeringState),\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup candidate; VNet peering itself has no standalone resource charge, but traffic charges may exist when active\",\n        OrphanConfidence=\"Review Required\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=strcat(\"RemoteVNet=\", remoteVirtualNetwork), tags=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags, Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/publicipprefixes\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.publicIPAddresses) or array_length(properties.publicIPAddresses) == 0\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Public IP prefix has no allocated child public IP addresses\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on prefix size, SKU, IP version, and region\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=strcat(\"PrefixLength=\", tostring(properties.prefixLength)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/applicationsecuritygroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.networkInterfaces) or array_length(properties.networkInterfaces) == 0\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Application Security Group is not associated with any network interface IP configuration\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; Application Security Groups do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.compute/proximityplacementgroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where (isnull(properties.virtualMachines) or array_length(properties.virtualMachines) == 0)\n        and (isnull(properties.availabilitySets) or array_length(properties.availabilitySets) == 0)\n        and (isnull(properties.virtualMachineScaleSets) or array_length(properties.virtualMachineScaleSets) == 0)\n    | extend Category=\"Compute\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Proximity placement group has no VMs, availability sets, or VM scale sets associated\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; Proximity Placement Groups do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=strcat(\"Intent=\", tostring(properties.proximityPlacementGroupType)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/serviceendpointpolicies\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.subnets) or array_length(properties.subnets) == 0\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Service endpoint policy is not associated with any subnet\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; Service Endpoint Policies do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    ResourceContainers\n    | where type =~ \"microsoft.resources/subscriptions/resourcegroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend rgAndSub=strcat(resourceGroup, \"--\", subscriptionId)\n    | join kind=leftouter (\n        resources\n        | extend rgAndSub=strcat(resourceGroup, \"--\", subscriptionId)\n        | summarize resourceCount=count() by rgAndSub\n    ) on rgAndSub\n    | where isnull(resourceCount)\n    | extend Category=\"Other\", Resource=id, ResourceName=resourceGroup, ResourceType=tolower(type),\n        OrphanReason=\"Resource group contains no visible or hidden resources\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; empty resource groups do not carry direct resource cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.web/connections\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | project Resource=id, ResourceName=name, subscriptionId, resourceGroup, tags, location, ResourceType=tolower(type), Details=pack_all()\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.logic/workflows\"\n        | extend var_json=properties[\"parameters\"][\"$connections\"][\"value\"]\n        | mv-expand var_connection=var_json\n        | where notnull(var_connection)\n        | extend connectionId=extract(\"connectionId\\\\\\\":\\\\\\\"(.*?)\\\\\\\"\", 1, tostring(var_connection))\n        | project connectionId\n    ) on $left.Resource == $right.connectionId\n    | where isempty(connectionId)\n    | extend Category=\"Other\",\n        OrphanReason=\"API connection is not referenced by Logic App workflow connection parameters\",\n        CostBearing=\"Review\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Review connector-specific billing before assigning savings\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\" \n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.web/certificates\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend expiresOn=todatetime(properties.expirationDate)\n    | where expiresOn <= now()\n    | extend Category=\"Other\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=strcat(\"Certificate expired on \", format_datetime(expiresOn, \"yyyy-MM-dd\")),\n        CostBearing=\"Review\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Review certificate SKU and renewal/billing model before assigning savings\",\n        OrphanConfidence=\"High\", ResourceAgeDays=datetime_diff(\"day\", now(), expiresOn),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n);OrphanResources\n| extend AzurePortalLink=strcat(\"https://portal.azure.com/#@/resource\", Resource)\n| summarize OrphanCount=count(), DirectCostCandidates=countif(CostBearing == \"Yes\") by subscriptionId | top 10 by OrphanCount desc",
              "size": 3,
              "title": "Top subscriptions by orphan count",
              "noDataMessage": "No results.",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "table"
            },
            "name": "query - Top Subscriptions by Orphans",
            "customWidth": "50"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let OrphanResources = union isfuzzy=true\n(\n    resources\n    | where type =~ \"microsoft.web/serverfarms\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.numberOfSites == 0\n    | extend Category=\"Compute\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"App Service plan has zero hosted apps\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; ARG does not expose actual billed cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(sku.tier), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.compute/availabilitysets\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where (isnull(properties.virtualMachines) or array_length(properties.virtualMachines) == 0)\n    | where not(name endswith \"-asr\")\n    | extend Category=\"Compute\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Availability set has no associated VMs and is not ASR generated\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; no direct standalone compute charge\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.compute/disks\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend diskState = tostring(properties.diskState)\n    | where (managedBy == \"\" and diskState != \"ActiveSAS\") or (diskState == \"Unattached\" and diskState != \"ActiveSAS\")\n    | where not(name endswith \"-ASRReplica\" or name startswith \"ms-asr-\" or name startswith \"asrseeddisk-\")\n    | where (tags !contains \"kubernetes.io-created-for-pvc\") and tags !contains \"ASR-ReplicaDisk\" and tags !contains \"asrseeddisk\" and tags !contains \"RSVaultBackup\"\n    | extend Category=\"Storage\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=strcat(\"Managed disk is \", diskState, \" and has no managedBy VM reference; ASR/AKS/backup patterns excluded\"),\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; join with Cost Management or pricing by region/SKU/size\",\n        OrphanConfidence=\"High\", ResourceAgeDays=datetime_diff(\"day\", now(), todatetime(properties.timeCreated)),\n        SKU=tostring(sku.name), Tier=strcat(\"SizeGB=\", tostring(properties.diskSizeGB)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.sql/servers/elasticpools\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | project elasticPoolId=tolower(id), Resource=id, ResourceName=name, ResourceType=tolower(type), resourceGroup, location, subscriptionId, tags, sku, Details=pack_all()\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.sql/servers/databases\"\n        | project databaseId=id, elasticPoolId=tolower(properties.elasticPoolId)\n    ) on elasticPoolId\n    | summarize databaseCount=countif(isnotempty(databaseId)), Details=any(Details), tags=any(tags), SKU=any(tostring(sku.name)), Tier=any(tostring(sku.tier)) by subscriptionId, resourceGroup, location, Resource, ResourceName, ResourceType\n    | where databaseCount == 0\n    | extend Category=\"Database\", OrphanReason=\"SQL elastic pool has no databases\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; ARG does not expose actual billed cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\")\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/publicipaddresses\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.ipConfiguration == \"\" and properties.natGateway == \"\" and properties.publicIPPrefix == \"\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Public IP has no IP configuration, NAT gateway, or public IP prefix association\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on SKU, allocation, region, and usage\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(properties.publicIPAllocationMethod), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/networkinterfaces\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.privateEndpoint)\n    | where isnull(properties.privateLinkService)\n    | where properties.hostedWorkloads == \"[]\"\n    | where properties !has \"virtualmachine\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Network interface has no VM, private endpoint, private link service, or hosted workload association\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; NICs normally do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=tostring(kind), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/networksecuritygroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.networkInterfaces) and isnull(properties.subnets)\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Network security group is not associated with any NIC or subnet\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; no direct standalone NSG charge\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/routetables\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.subnets)\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Route table is not associated with any subnet\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; no direct standalone route table charge\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/loadbalancers\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.backendAddressPools == \"[]\" and properties.inboundNatRules == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Load balancer has no backend pools and no inbound NAT rules\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate for Standard/Gateway tiers; validate actual Cost Management charges\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(sku.tier), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/frontdoorwebapplicationfirewallpolicies\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.securityPolicyLinks == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Front Door WAF policy has no security policy links\",\n        CostBearing=\"Review\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Review billing and Front Door associations before assigning savings\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(sku.tier), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/trafficmanagerprofiles\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.endpoints == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Traffic Manager profile has no endpoints\",\n        CostBearing=\"Review\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Review DNS/query charges before assigning savings\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/applicationgateways\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend AppGwId=tostring(id), SKU=tostring(properties.sku.name), Tier=tostring(properties.sku.tier), Details=pack_all()\n    | project AppGwId, ResourceName=name, resourceGroup, location, subscriptionId, tags, ResourceType=tolower(type), SKU, Tier, Details\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.network/applicationgateways\"\n        | mv-expand backendPools=properties.backendAddressPools\n        | extend AppGwId=tostring(id), backendIPCount=array_length(backendPools.properties.backendIPConfigurations), backendAddressesCount=array_length(backendPools.properties.backendAddresses)\n        | summarize backendIPCount=sum(backendIPCount), backendAddressesCount=sum(backendAddressesCount) by AppGwId\n    ) on AppGwId\n    | where (backendIPCount == 0 or isempty(backendIPCount)) and (backendAddressesCount == 0 or isempty(backendAddressesCount))\n    | extend Category=\"Networking\", Resource=AppGwId,\n        OrphanReason=\"Application gateway backend pools contain no backend IP configurations or backend addresses\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on SKU, capacity, region, and usage\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\")\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/virtualnetworks\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.subnets == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Virtual network has no subnets\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; VNets do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/virtualnetworks\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | mv-expand subnet=properties.subnets\n    | extend ipConfigurations=subnet.properties.ipConfigurations, delegations=subnet.properties.delegations, applicationGatewayIPConfigurations=subnet.properties.applicationGatewayIPConfigurations\n    | where isnull(ipConfigurations) and delegations == \"[]\" and isnull(applicationGatewayIPConfigurations)\n    | extend Category=\"Networking\", Resource=tostring(subnet.id), ResourceName=strcat(name, \"/\", tostring(subnet.name)), ResourceType=\"microsoft.network/virtualnetworks/subnets\",\n        OrphanReason=\"Subnet has no connected devices, delegations, or application gateway IP configurations\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; subnets do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", tags=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags, Details\n\n),\n(\n    resources\n    | where type =~ \"microsoft.network/natgateways\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.subnets)\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"NAT gateway is not associated with any subnet\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on region and processed data\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(sku.tier), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/ipgroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.firewalls == \"[]\" and properties.firewallPolicies == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"IP group is not referenced by Azure Firewall or Firewall Policy\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; no direct standalone IP Group charge\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/privatednszones\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.numberOfVirtualNetworkLinks == 0\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Private DNS zone has zero virtual network links\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on zone and query/record activity\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=strcat(\"RecordSets=\", tostring(properties.numberOfRecordSets)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/privateendpoints\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend connection=iff(array_length(properties.manualPrivateLinkServiceConnections) > 0, properties.manualPrivateLinkServiceConnections[0], properties.privateLinkServiceConnections[0])\n    | extend stateEnum=tostring(connection.properties.privateLinkServiceConnectionState.status)\n    | where stateEnum == \"Disconnected\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Private endpoint connection state is Disconnected\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; validate connection state and actual billed cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=tostring(connection.properties.groupIds[0]), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/virtualnetworkgateways\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend Resource=id, ResourceName=name, ResourceType=tolower(type), SKU=tostring(properties.sku.name), Tier=tostring(properties.sku.tier), GatewayType=tostring(properties.gatewayType), vpnClientConfiguration=properties.vpnClientConfiguration, Details=pack_all()\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.network/connections\"\n        | mv-expand Resource=pack_array(properties.virtualNetworkGateway1.id, properties.virtualNetworkGateway2.id) to typeof(string)\n        | project Resource, connectionId=id\n    ) on Resource\n    | where isempty(vpnClientConfiguration) and isempty(connectionId)\n    | extend Category=\"Networking\",\n        OrphanReason=\"Virtual network gateway has no point-to-site configuration and no gateway connections\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on gateway SKU, region, and runtime\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        Tier=strcat(Tier, \"; \", GatewayType)\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/ddosprotectionplans\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.virtualNetworks)\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"DDoS protection plan has no associated virtual networks\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; validate actual plan charges in Cost Management\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.compute/snapshots\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isempty(managedBy)\n    | where not(name startswith \"sigs-\" or name startswith \"sigs_\")\n    | extend Category=\"Storage\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Snapshot has no managedBy relationship; review retention policy before deleting\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct storage cost candidate; validate size, SKU, region, and retention requirements in Cost Management\",\n        OrphanConfidence=\"Review Required\", ResourceAgeDays=datetime_diff(\"day\", now(), todatetime(properties.timeCreated)),\n        SKU=tostring(sku.name), Tier=strcat(\"SizeGB=\", tostring(properties.diskSizeGB)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/virtualnetworks\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where array_length(properties.virtualNetworkPeerings) > 0\n    | mv-expand peering=properties.virtualNetworkPeerings\n    | extend peeringState=tostring(peering.properties.peeringState), remoteVirtualNetwork=tostring(peering.properties.remoteVirtualNetwork.id)\n    | where peeringState !~ \"Connected\"\n    | where id < remoteVirtualNetwork\n    | extend Category=\"Networking\", Resource=tostring(peering.id), ResourceName=strcat(name, \"/\", tostring(peering.name)), ResourceType=\"microsoft.network/virtualnetworks/virtualnetworkpeerings\",\n        OrphanReason=strcat(\"VNet peering is not connected; current state is \", peeringState),\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup candidate; VNet peering itself has no standalone resource charge, but traffic charges may exist when active\",\n        OrphanConfidence=\"Review Required\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=strcat(\"RemoteVNet=\", remoteVirtualNetwork), tags=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags, Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/publicipprefixes\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.publicIPAddresses) or array_length(properties.publicIPAddresses) == 0\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Public IP prefix has no allocated child public IP addresses\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on prefix size, SKU, IP version, and region\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=strcat(\"PrefixLength=\", tostring(properties.prefixLength)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/applicationsecuritygroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.networkInterfaces) or array_length(properties.networkInterfaces) == 0\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Application Security Group is not associated with any network interface IP configuration\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; Application Security Groups do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.compute/proximityplacementgroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where (isnull(properties.virtualMachines) or array_length(properties.virtualMachines) == 0)\n        and (isnull(properties.availabilitySets) or array_length(properties.availabilitySets) == 0)\n        and (isnull(properties.virtualMachineScaleSets) or array_length(properties.virtualMachineScaleSets) == 0)\n    | extend Category=\"Compute\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Proximity placement group has no VMs, availability sets, or VM scale sets associated\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; Proximity Placement Groups do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=strcat(\"Intent=\", tostring(properties.proximityPlacementGroupType)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/serviceendpointpolicies\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.subnets) or array_length(properties.subnets) == 0\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Service endpoint policy is not associated with any subnet\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; Service Endpoint Policies do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    ResourceContainers\n    | where type =~ \"microsoft.resources/subscriptions/resourcegroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend rgAndSub=strcat(resourceGroup, \"--\", subscriptionId)\n    | join kind=leftouter (\n        resources\n        | extend rgAndSub=strcat(resourceGroup, \"--\", subscriptionId)\n        | summarize resourceCount=count() by rgAndSub\n    ) on rgAndSub\n    | where isnull(resourceCount)\n    | extend Category=\"Other\", Resource=id, ResourceName=resourceGroup, ResourceType=tolower(type),\n        OrphanReason=\"Resource group contains no visible or hidden resources\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; empty resource groups do not carry direct resource cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.web/connections\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | project Resource=id, ResourceName=name, subscriptionId, resourceGroup, tags, location, ResourceType=tolower(type), Details=pack_all()\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.logic/workflows\"\n        | extend var_json=properties[\"parameters\"][\"$connections\"][\"value\"]\n        | mv-expand var_connection=var_json\n        | where notnull(var_connection)\n        | extend connectionId=extract(\"connectionId\\\\\\\":\\\\\\\"(.*?)\\\\\\\"\", 1, tostring(var_connection))\n        | project connectionId\n    ) on $left.Resource == $right.connectionId\n    | where isempty(connectionId)\n    | extend Category=\"Other\",\n        OrphanReason=\"API connection is not referenced by Logic App workflow connection parameters\",\n        CostBearing=\"Review\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Review connector-specific billing before assigning savings\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\" \n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.web/certificates\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend expiresOn=todatetime(properties.expirationDate)\n    | where expiresOn <= now()\n    | extend Category=\"Other\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=strcat(\"Certificate expired on \", format_datetime(expiresOn, \"yyyy-MM-dd\")),\n        CostBearing=\"Review\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Review certificate SKU and renewal/billing model before assigning savings\",\n        OrphanConfidence=\"High\", ResourceAgeDays=datetime_diff(\"day\", now(), expiresOn),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n);OrphanResources\n| extend AzurePortalLink=strcat(\"https://portal.azure.com/#@/resource\", Resource)\n| summarize OrphanCount=count(), DirectCostCandidates=countif(CostBearing == \"Yes\") by subscriptionId, resourceGroup | top 10 by OrphanCount desc",
              "size": 3,
              "title": "Top resource groups by orphan count",
              "noDataMessage": "No results.",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "table"
            },
            "name": "query - Top Resource Groups by Orphans",
            "customWidth": "50"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let OrphanResources = union isfuzzy=true\n(\n    resources\n    | where type =~ \"microsoft.web/serverfarms\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.numberOfSites == 0\n    | extend Category=\"Compute\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"App Service plan has zero hosted apps\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; ARG does not expose actual billed cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(sku.tier), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.compute/availabilitysets\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where (isnull(properties.virtualMachines) or array_length(properties.virtualMachines) == 0)\n    | where not(name endswith \"-asr\")\n    | extend Category=\"Compute\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Availability set has no associated VMs and is not ASR generated\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; no direct standalone compute charge\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.compute/disks\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend diskState = tostring(properties.diskState)\n    | where (managedBy == \"\" and diskState != \"ActiveSAS\") or (diskState == \"Unattached\" and diskState != \"ActiveSAS\")\n    | where not(name endswith \"-ASRReplica\" or name startswith \"ms-asr-\" or name startswith \"asrseeddisk-\")\n    | where (tags !contains \"kubernetes.io-created-for-pvc\") and tags !contains \"ASR-ReplicaDisk\" and tags !contains \"asrseeddisk\" and tags !contains \"RSVaultBackup\"\n    | extend Category=\"Storage\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=strcat(\"Managed disk is \", diskState, \" and has no managedBy VM reference; ASR/AKS/backup patterns excluded\"),\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; join with Cost Management or pricing by region/SKU/size\",\n        OrphanConfidence=\"High\", ResourceAgeDays=datetime_diff(\"day\", now(), todatetime(properties.timeCreated)),\n        SKU=tostring(sku.name), Tier=strcat(\"SizeGB=\", tostring(properties.diskSizeGB)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.sql/servers/elasticpools\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | project elasticPoolId=tolower(id), Resource=id, ResourceName=name, ResourceType=tolower(type), resourceGroup, location, subscriptionId, tags, sku, Details=pack_all()\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.sql/servers/databases\"\n        | project databaseId=id, elasticPoolId=tolower(properties.elasticPoolId)\n    ) on elasticPoolId\n    | summarize databaseCount=countif(isnotempty(databaseId)), Details=any(Details), tags=any(tags), SKU=any(tostring(sku.name)), Tier=any(tostring(sku.tier)) by subscriptionId, resourceGroup, location, Resource, ResourceName, ResourceType\n    | where databaseCount == 0\n    | extend Category=\"Database\", OrphanReason=\"SQL elastic pool has no databases\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; ARG does not expose actual billed cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\")\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/publicipaddresses\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.ipConfiguration == \"\" and properties.natGateway == \"\" and properties.publicIPPrefix == \"\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Public IP has no IP configuration, NAT gateway, or public IP prefix association\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on SKU, allocation, region, and usage\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(properties.publicIPAllocationMethod), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/networkinterfaces\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.privateEndpoint)\n    | where isnull(properties.privateLinkService)\n    | where properties.hostedWorkloads == \"[]\"\n    | where properties !has \"virtualmachine\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Network interface has no VM, private endpoint, private link service, or hosted workload association\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; NICs normally do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=tostring(kind), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/networksecuritygroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.networkInterfaces) and isnull(properties.subnets)\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Network security group is not associated with any NIC or subnet\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; no direct standalone NSG charge\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/routetables\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.subnets)\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Route table is not associated with any subnet\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; no direct standalone route table charge\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/loadbalancers\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.backendAddressPools == \"[]\" and properties.inboundNatRules == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Load balancer has no backend pools and no inbound NAT rules\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate for Standard/Gateway tiers; validate actual Cost Management charges\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(sku.tier), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/frontdoorwebapplicationfirewallpolicies\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.securityPolicyLinks == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Front Door WAF policy has no security policy links\",\n        CostBearing=\"Review\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Review billing and Front Door associations before assigning savings\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(sku.tier), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/trafficmanagerprofiles\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.endpoints == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Traffic Manager profile has no endpoints\",\n        CostBearing=\"Review\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Review DNS/query charges before assigning savings\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/applicationgateways\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend AppGwId=tostring(id), SKU=tostring(properties.sku.name), Tier=tostring(properties.sku.tier), Details=pack_all()\n    | project AppGwId, ResourceName=name, resourceGroup, location, subscriptionId, tags, ResourceType=tolower(type), SKU, Tier, Details\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.network/applicationgateways\"\n        | mv-expand backendPools=properties.backendAddressPools\n        | extend AppGwId=tostring(id), backendIPCount=array_length(backendPools.properties.backendIPConfigurations), backendAddressesCount=array_length(backendPools.properties.backendAddresses)\n        | summarize backendIPCount=sum(backendIPCount), backendAddressesCount=sum(backendAddressesCount) by AppGwId\n    ) on AppGwId\n    | where (backendIPCount == 0 or isempty(backendIPCount)) and (backendAddressesCount == 0 or isempty(backendAddressesCount))\n    | extend Category=\"Networking\", Resource=AppGwId,\n        OrphanReason=\"Application gateway backend pools contain no backend IP configurations or backend addresses\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on SKU, capacity, region, and usage\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\")\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/virtualnetworks\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.subnets == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Virtual network has no subnets\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; VNets do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/virtualnetworks\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | mv-expand subnet=properties.subnets\n    | extend ipConfigurations=subnet.properties.ipConfigurations, delegations=subnet.properties.delegations, applicationGatewayIPConfigurations=subnet.properties.applicationGatewayIPConfigurations\n    | where isnull(ipConfigurations) and delegations == \"[]\" and isnull(applicationGatewayIPConfigurations)\n    | extend Category=\"Networking\", Resource=tostring(subnet.id), ResourceName=strcat(name, \"/\", tostring(subnet.name)), ResourceType=\"microsoft.network/virtualnetworks/subnets\",\n        OrphanReason=\"Subnet has no connected devices, delegations, or application gateway IP configurations\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; subnets do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", tags=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags, Details\n\n),\n(\n    resources\n    | where type =~ \"microsoft.network/natgateways\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.subnets)\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"NAT gateway is not associated with any subnet\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on region and processed data\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(sku.tier), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/ipgroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.firewalls == \"[]\" and properties.firewallPolicies == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"IP group is not referenced by Azure Firewall or Firewall Policy\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; no direct standalone IP Group charge\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/privatednszones\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.numberOfVirtualNetworkLinks == 0\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Private DNS zone has zero virtual network links\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on zone and query/record activity\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=strcat(\"RecordSets=\", tostring(properties.numberOfRecordSets)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/privateendpoints\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend connection=iff(array_length(properties.manualPrivateLinkServiceConnections) > 0, properties.manualPrivateLinkServiceConnections[0], properties.privateLinkServiceConnections[0])\n    | extend stateEnum=tostring(connection.properties.privateLinkServiceConnectionState.status)\n    | where stateEnum == \"Disconnected\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Private endpoint connection state is Disconnected\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; validate connection state and actual billed cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=tostring(connection.properties.groupIds[0]), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/virtualnetworkgateways\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend Resource=id, ResourceName=name, ResourceType=tolower(type), SKU=tostring(properties.sku.name), Tier=tostring(properties.sku.tier), GatewayType=tostring(properties.gatewayType), vpnClientConfiguration=properties.vpnClientConfiguration, Details=pack_all()\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.network/connections\"\n        | mv-expand Resource=pack_array(properties.virtualNetworkGateway1.id, properties.virtualNetworkGateway2.id) to typeof(string)\n        | project Resource, connectionId=id\n    ) on Resource\n    | where isempty(vpnClientConfiguration) and isempty(connectionId)\n    | extend Category=\"Networking\",\n        OrphanReason=\"Virtual network gateway has no point-to-site configuration and no gateway connections\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on gateway SKU, region, and runtime\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        Tier=strcat(Tier, \"; \", GatewayType)\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/ddosprotectionplans\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.virtualNetworks)\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"DDoS protection plan has no associated virtual networks\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; validate actual plan charges in Cost Management\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.compute/snapshots\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isempty(managedBy)\n    | where not(name startswith \"sigs-\" or name startswith \"sigs_\")\n    | extend Category=\"Storage\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Snapshot has no managedBy relationship; review retention policy before deleting\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct storage cost candidate; validate size, SKU, region, and retention requirements in Cost Management\",\n        OrphanConfidence=\"Review Required\", ResourceAgeDays=datetime_diff(\"day\", now(), todatetime(properties.timeCreated)),\n        SKU=tostring(sku.name), Tier=strcat(\"SizeGB=\", tostring(properties.diskSizeGB)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/virtualnetworks\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where array_length(properties.virtualNetworkPeerings) > 0\n    | mv-expand peering=properties.virtualNetworkPeerings\n    | extend peeringState=tostring(peering.properties.peeringState), remoteVirtualNetwork=tostring(peering.properties.remoteVirtualNetwork.id)\n    | where peeringState !~ \"Connected\"\n    | where id < remoteVirtualNetwork\n    | extend Category=\"Networking\", Resource=tostring(peering.id), ResourceName=strcat(name, \"/\", tostring(peering.name)), ResourceType=\"microsoft.network/virtualnetworks/virtualnetworkpeerings\",\n        OrphanReason=strcat(\"VNet peering is not connected; current state is \", peeringState),\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup candidate; VNet peering itself has no standalone resource charge, but traffic charges may exist when active\",\n        OrphanConfidence=\"Review Required\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=strcat(\"RemoteVNet=\", remoteVirtualNetwork), tags=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags, Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/publicipprefixes\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.publicIPAddresses) or array_length(properties.publicIPAddresses) == 0\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Public IP prefix has no allocated child public IP addresses\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on prefix size, SKU, IP version, and region\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=strcat(\"PrefixLength=\", tostring(properties.prefixLength)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/applicationsecuritygroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.networkInterfaces) or array_length(properties.networkInterfaces) == 0\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Application Security Group is not associated with any network interface IP configuration\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; Application Security Groups do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.compute/proximityplacementgroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where (isnull(properties.virtualMachines) or array_length(properties.virtualMachines) == 0)\n        and (isnull(properties.availabilitySets) or array_length(properties.availabilitySets) == 0)\n        and (isnull(properties.virtualMachineScaleSets) or array_length(properties.virtualMachineScaleSets) == 0)\n    | extend Category=\"Compute\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Proximity placement group has no VMs, availability sets, or VM scale sets associated\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; Proximity Placement Groups do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=strcat(\"Intent=\", tostring(properties.proximityPlacementGroupType)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/serviceendpointpolicies\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.subnets) or array_length(properties.subnets) == 0\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Service endpoint policy is not associated with any subnet\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; Service Endpoint Policies do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    ResourceContainers\n    | where type =~ \"microsoft.resources/subscriptions/resourcegroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend rgAndSub=strcat(resourceGroup, \"--\", subscriptionId)\n    | join kind=leftouter (\n        resources\n        | extend rgAndSub=strcat(resourceGroup, \"--\", subscriptionId)\n        | summarize resourceCount=count() by rgAndSub\n    ) on rgAndSub\n    | where isnull(resourceCount)\n    | extend Category=\"Other\", Resource=id, ResourceName=resourceGroup, ResourceType=tolower(type),\n        OrphanReason=\"Resource group contains no visible or hidden resources\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; empty resource groups do not carry direct resource cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.web/connections\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | project Resource=id, ResourceName=name, subscriptionId, resourceGroup, tags, location, ResourceType=tolower(type), Details=pack_all()\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.logic/workflows\"\n        | extend var_json=properties[\"parameters\"][\"$connections\"][\"value\"]\n        | mv-expand var_connection=var_json\n        | where notnull(var_connection)\n        | extend connectionId=extract(\"connectionId\\\\\\\":\\\\\\\"(.*?)\\\\\\\"\", 1, tostring(var_connection))\n        | project connectionId\n    ) on $left.Resource == $right.connectionId\n    | where isempty(connectionId)\n    | extend Category=\"Other\",\n        OrphanReason=\"API connection is not referenced by Logic App workflow connection parameters\",\n        CostBearing=\"Review\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Review connector-specific billing before assigning savings\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\" \n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.web/certificates\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend expiresOn=todatetime(properties.expirationDate)\n    | where expiresOn <= now()\n    | extend Category=\"Other\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=strcat(\"Certificate expired on \", format_datetime(expiresOn, \"yyyy-MM-dd\")),\n        CostBearing=\"Review\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Review certificate SKU and renewal/billing model before assigning savings\",\n        OrphanConfidence=\"High\", ResourceAgeDays=datetime_diff(\"day\", now(), expiresOn),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n);OrphanResources\n| extend AzurePortalLink=strcat(\"https://portal.azure.com/#@/resource\", Resource)\n| where CostBearing == \"Yes\" | summarize DirectCostCandidates=count() by ResourceType | top 10 by DirectCostCandidates desc",
              "size": 3,
              "title": "Top resource types by direct-cost candidates",
              "noDataMessage": "No results.",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "barchart"
            },
            "name": "query - Cost Candidate Types",
            "customWidth": "50"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let OrphanResources = union isfuzzy=true\n(\n    resources\n    | where type =~ \"microsoft.web/serverfarms\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.numberOfSites == 0\n    | extend Category=\"Compute\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"App Service plan has zero hosted apps\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; ARG does not expose actual billed cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(sku.tier), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.compute/availabilitysets\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where (isnull(properties.virtualMachines) or array_length(properties.virtualMachines) == 0)\n    | where not(name endswith \"-asr\")\n    | extend Category=\"Compute\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Availability set has no associated VMs and is not ASR generated\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; no direct standalone compute charge\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.compute/disks\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend diskState = tostring(properties.diskState)\n    | where (managedBy == \"\" and diskState != \"ActiveSAS\") or (diskState == \"Unattached\" and diskState != \"ActiveSAS\")\n    | where not(name endswith \"-ASRReplica\" or name startswith \"ms-asr-\" or name startswith \"asrseeddisk-\")\n    | where (tags !contains \"kubernetes.io-created-for-pvc\") and tags !contains \"ASR-ReplicaDisk\" and tags !contains \"asrseeddisk\" and tags !contains \"RSVaultBackup\"\n    | extend Category=\"Storage\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=strcat(\"Managed disk is \", diskState, \" and has no managedBy VM reference; ASR/AKS/backup patterns excluded\"),\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; join with Cost Management or pricing by region/SKU/size\",\n        OrphanConfidence=\"High\", ResourceAgeDays=datetime_diff(\"day\", now(), todatetime(properties.timeCreated)),\n        SKU=tostring(sku.name), Tier=strcat(\"SizeGB=\", tostring(properties.diskSizeGB)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.sql/servers/elasticpools\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | project elasticPoolId=tolower(id), Resource=id, ResourceName=name, ResourceType=tolower(type), resourceGroup, location, subscriptionId, tags, sku, Details=pack_all()\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.sql/servers/databases\"\n        | project databaseId=id, elasticPoolId=tolower(properties.elasticPoolId)\n    ) on elasticPoolId\n    | summarize databaseCount=countif(isnotempty(databaseId)), Details=any(Details), tags=any(tags), SKU=any(tostring(sku.name)), Tier=any(tostring(sku.tier)) by subscriptionId, resourceGroup, location, Resource, ResourceName, ResourceType\n    | where databaseCount == 0\n    | extend Category=\"Database\", OrphanReason=\"SQL elastic pool has no databases\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; ARG does not expose actual billed cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\")\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/publicipaddresses\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.ipConfiguration == \"\" and properties.natGateway == \"\" and properties.publicIPPrefix == \"\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Public IP has no IP configuration, NAT gateway, or public IP prefix association\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on SKU, allocation, region, and usage\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(properties.publicIPAllocationMethod), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/networkinterfaces\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.privateEndpoint)\n    | where isnull(properties.privateLinkService)\n    | where properties.hostedWorkloads == \"[]\"\n    | where properties !has \"virtualmachine\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Network interface has no VM, private endpoint, private link service, or hosted workload association\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; NICs normally do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=tostring(kind), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/networksecuritygroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.networkInterfaces) and isnull(properties.subnets)\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Network security group is not associated with any NIC or subnet\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; no direct standalone NSG charge\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/routetables\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.subnets)\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Route table is not associated with any subnet\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; no direct standalone route table charge\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/loadbalancers\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.backendAddressPools == \"[]\" and properties.inboundNatRules == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Load balancer has no backend pools and no inbound NAT rules\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate for Standard/Gateway tiers; validate actual Cost Management charges\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(sku.tier), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/frontdoorwebapplicationfirewallpolicies\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.securityPolicyLinks == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Front Door WAF policy has no security policy links\",\n        CostBearing=\"Review\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Review billing and Front Door associations before assigning savings\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(sku.tier), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/trafficmanagerprofiles\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.endpoints == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Traffic Manager profile has no endpoints\",\n        CostBearing=\"Review\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Review DNS/query charges before assigning savings\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/applicationgateways\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend AppGwId=tostring(id), SKU=tostring(properties.sku.name), Tier=tostring(properties.sku.tier), Details=pack_all()\n    | project AppGwId, ResourceName=name, resourceGroup, location, subscriptionId, tags, ResourceType=tolower(type), SKU, Tier, Details\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.network/applicationgateways\"\n        | mv-expand backendPools=properties.backendAddressPools\n        | extend AppGwId=tostring(id), backendIPCount=array_length(backendPools.properties.backendIPConfigurations), backendAddressesCount=array_length(backendPools.properties.backendAddresses)\n        | summarize backendIPCount=sum(backendIPCount), backendAddressesCount=sum(backendAddressesCount) by AppGwId\n    ) on AppGwId\n    | where (backendIPCount == 0 or isempty(backendIPCount)) and (backendAddressesCount == 0 or isempty(backendAddressesCount))\n    | extend Category=\"Networking\", Resource=AppGwId,\n        OrphanReason=\"Application gateway backend pools contain no backend IP configurations or backend addresses\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on SKU, capacity, region, and usage\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\")\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/virtualnetworks\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.subnets == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Virtual network has no subnets\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; VNets do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/virtualnetworks\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | mv-expand subnet=properties.subnets\n    | extend ipConfigurations=subnet.properties.ipConfigurations, delegations=subnet.properties.delegations, applicationGatewayIPConfigurations=subnet.properties.applicationGatewayIPConfigurations\n    | where isnull(ipConfigurations) and delegations == \"[]\" and isnull(applicationGatewayIPConfigurations)\n    | extend Category=\"Networking\", Resource=tostring(subnet.id), ResourceName=strcat(name, \"/\", tostring(subnet.name)), ResourceType=\"microsoft.network/virtualnetworks/subnets\",\n        OrphanReason=\"Subnet has no connected devices, delegations, or application gateway IP configurations\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; subnets do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", tags=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags, Details\n\n),\n(\n    resources\n    | where type =~ \"microsoft.network/natgateways\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.subnets)\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"NAT gateway is not associated with any subnet\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on region and processed data\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=tostring(sku.tier), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/ipgroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.firewalls == \"[]\" and properties.firewallPolicies == \"[]\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"IP group is not referenced by Azure Firewall or Firewall Policy\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; no direct standalone IP Group charge\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/privatednszones\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where properties.numberOfVirtualNetworkLinks == 0\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Private DNS zone has zero virtual network links\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on zone and query/record activity\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=strcat(\"RecordSets=\", tostring(properties.numberOfRecordSets)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/privateendpoints\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend connection=iff(array_length(properties.manualPrivateLinkServiceConnections) > 0, properties.manualPrivateLinkServiceConnections[0], properties.privateLinkServiceConnections[0])\n    | extend stateEnum=tostring(connection.properties.privateLinkServiceConnectionState.status)\n    | where stateEnum == \"Disconnected\"\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Private endpoint connection state is Disconnected\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; validate connection state and actual billed cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=tostring(connection.properties.groupIds[0]), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/virtualnetworkgateways\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend Resource=id, ResourceName=name, ResourceType=tolower(type), SKU=tostring(properties.sku.name), Tier=tostring(properties.sku.tier), GatewayType=tostring(properties.gatewayType), vpnClientConfiguration=properties.vpnClientConfiguration, Details=pack_all()\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.network/connections\"\n        | mv-expand Resource=pack_array(properties.virtualNetworkGateway1.id, properties.virtualNetworkGateway2.id) to typeof(string)\n        | project Resource, connectionId=id\n    ) on Resource\n    | where isempty(vpnClientConfiguration) and isempty(connectionId)\n    | extend Category=\"Networking\",\n        OrphanReason=\"Virtual network gateway has no point-to-site configuration and no gateway connections\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on gateway SKU, region, and runtime\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        Tier=strcat(Tier, \"; \", GatewayType)\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/ddosprotectionplans\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.virtualNetworks)\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"DDoS protection plan has no associated virtual networks\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; validate actual plan charges in Cost Management\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.compute/snapshots\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isempty(managedBy)\n    | where not(name startswith \"sigs-\" or name startswith \"sigs_\")\n    | extend Category=\"Storage\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Snapshot has no managedBy relationship; review retention policy before deleting\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct storage cost candidate; validate size, SKU, region, and retention requirements in Cost Management\",\n        OrphanConfidence=\"Review Required\", ResourceAgeDays=datetime_diff(\"day\", now(), todatetime(properties.timeCreated)),\n        SKU=tostring(sku.name), Tier=strcat(\"SizeGB=\", tostring(properties.diskSizeGB)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/virtualnetworks\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where array_length(properties.virtualNetworkPeerings) > 0\n    | mv-expand peering=properties.virtualNetworkPeerings\n    | extend peeringState=tostring(peering.properties.peeringState), remoteVirtualNetwork=tostring(peering.properties.remoteVirtualNetwork.id)\n    | where peeringState !~ \"Connected\"\n    | where id < remoteVirtualNetwork\n    | extend Category=\"Networking\", Resource=tostring(peering.id), ResourceName=strcat(name, \"/\", tostring(peering.name)), ResourceType=\"microsoft.network/virtualnetworks/virtualnetworkpeerings\",\n        OrphanReason=strcat(\"VNet peering is not connected; current state is \", peeringState),\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup candidate; VNet peering itself has no standalone resource charge, but traffic charges may exist when active\",\n        OrphanConfidence=\"Review Required\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=strcat(\"RemoteVNet=\", remoteVirtualNetwork), tags=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags, Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/publicipprefixes\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.publicIPAddresses) or array_length(properties.publicIPAddresses) == 0\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Public IP prefix has no allocated child public IP addresses\",\n        CostBearing=\"Yes\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Direct cost candidate; pricing depends on prefix size, SKU, IP version, and region\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=tostring(sku.name), Tier=strcat(\"PrefixLength=\", tostring(properties.prefixLength)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/applicationsecuritygroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.networkInterfaces) or array_length(properties.networkInterfaces) == 0\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Application Security Group is not associated with any network interface IP configuration\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; Application Security Groups do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.compute/proximityplacementgroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where (isnull(properties.virtualMachines) or array_length(properties.virtualMachines) == 0)\n        and (isnull(properties.availabilitySets) or array_length(properties.availabilitySets) == 0)\n        and (isnull(properties.virtualMachineScaleSets) or array_length(properties.virtualMachineScaleSets) == 0)\n    | extend Category=\"Compute\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Proximity placement group has no VMs, availability sets, or VM scale sets associated\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; Proximity Placement Groups do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=strcat(\"Intent=\", tostring(properties.proximityPlacementGroupType)), Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.network/serviceendpointpolicies\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | where isnull(properties.subnets) or array_length(properties.subnets) == 0\n    | extend Category=\"Networking\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=\"Service endpoint policy is not associated with any subnet\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; Service Endpoint Policies do not carry direct standalone cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    ResourceContainers\n    | where type =~ \"microsoft.resources/subscriptions/resourcegroups\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend rgAndSub=strcat(resourceGroup, \"--\", subscriptionId)\n    | join kind=leftouter (\n        resources\n        | extend rgAndSub=strcat(resourceGroup, \"--\", subscriptionId)\n        | summarize resourceCount=count() by rgAndSub\n    ) on rgAndSub\n    | where isnull(resourceCount)\n    | extend Category=\"Other\", Resource=id, ResourceName=resourceGroup, ResourceType=tolower(type),\n        OrphanReason=\"Resource group contains no visible or hidden resources\",\n        CostBearing=\"No\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Governance cleanup; empty resource groups do not carry direct resource cost\",\n        OrphanConfidence=\"High\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.web/connections\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | project Resource=id, ResourceName=name, subscriptionId, resourceGroup, tags, location, ResourceType=tolower(type), Details=pack_all()\n    | join kind=leftouter (\n        resources\n        | where type =~ \"microsoft.logic/workflows\"\n        | extend var_json=properties[\"parameters\"][\"$connections\"][\"value\"]\n        | mv-expand var_connection=var_json\n        | where notnull(var_connection)\n        | extend connectionId=extract(\"connectionId\\\\\\\":\\\\\\\"(.*?)\\\\\\\"\", 1, tostring(var_connection))\n        | project connectionId\n    ) on $left.Resource == $right.connectionId\n    | where isempty(connectionId)\n    | extend Category=\"Other\",\n        OrphanReason=\"API connection is not referenced by Logic App workflow connection parameters\",\n        CostBearing=\"Review\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Review connector-specific billing before assigning savings\",\n        OrphanConfidence=\"Medium\", ResourceAgeDays=tolong(\"\"),\n        SKU=\"\", Tier=\"\" \n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n),\n(\n    resources\n    | where type =~ \"microsoft.web/certificates\"\n    | where resourceGroup in~ ({ResourceGroup:value})\n    | extend expiresOn=todatetime(properties.expirationDate)\n    | where expiresOn <= now()\n    | extend Category=\"Other\", Resource=id, ResourceName=name, ResourceType=tolower(type),\n        OrphanReason=strcat(\"Certificate expired on \", format_datetime(expiresOn, \"yyyy-MM-dd\")),\n        CostBearing=\"Review\", EstimatedMonthlySavingsUSD=todouble(\"\"),\n        CostEstimateStatus=\"Review certificate SKU and renewal/billing model before assigning savings\",\n        OrphanConfidence=\"High\", ResourceAgeDays=datetime_diff(\"day\", now(), expiresOn),\n        SKU=\"\", Tier=\"\", Details=pack_all()\n    | project subscriptionId, resourceGroup, ResourceName, Resource, ResourceType, Category, location, OrphanReason, CostBearing, EstimatedMonthlySavingsUSD, CostEstimateStatus, OrphanConfidence, ResourceAgeDays, SKU, Tier, tags=tostring(tags), Details\n);OrphanResources\n| extend AzurePortalLink=strcat(\"https://portal.azure.com/#@/resource\", Resource)\n| where isnotnull(ResourceAgeDays) | extend AgeBucket=case(ResourceAgeDays < 30, \"<30 days\", ResourceAgeDays < 90, \"30-89 days\", ResourceAgeDays < 180, \"90-179 days\", ResourceAgeDays < 365, \"180-364 days\", \">=365 days\") | summarize Count=count() by AgeBucket | order by AgeBucket asc",
              "size": 3,
              "title": "Age distribution where ARG exposes timestamps",
              "noDataMessage": "No results.",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "visualization": "barchart"
            },
            "name": "query - Age Distribution",
            "customWidth": "50"
          },
          {
            "type": 1,
            "content": {
              "json": "### Azure Orphaned Resources Workbook\r\n\r\nThe purpose of this workbook is to provide an overview of your orphaned resources, enabling you to enhance efficiency by:\r\n\r\n- Saving money\r\n- Prevent misconfiguration\r\n- Simplify operations\r\n\r\n<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"19px\" height=\"19px\" viewBox=\"0 0 19 18\" version=\"1.1\"><g id=\"surface1\"><path style=\" stroke:none;fill-rule:evenodd;fill:rgb(14.117647%,16.078431%,18.431373%);fill-opacity:1;\" d=\"M 9.472656 0 C 4.234375 0 0 4.125 0 9.226562 C 0 13.308594 2.714844 16.761719 6.476562 17.984375 C 6.945312 18.074219 7.121094 17.785156 7.121094 17.539062 C 7.121094 17.324219 7.105469 16.59375 7.105469 15.828125 C 4.46875 16.378906 3.921875 14.726562 3.921875 14.726562 C 3.496094 13.660156 2.871094 13.382812 2.871094 13.382812 C 2.007812 12.820312 2.933594 12.820312 2.933594 12.820312 C 3.890625 12.878906 4.390625 13.765625 4.390625 13.765625 C 5.238281 15.171875 6.601562 14.773438 7.152344 14.53125 C 7.230469 13.933594 7.480469 13.519531 7.746094 13.292969 C 5.644531 13.078125 3.433594 12.285156 3.433594 8.738281 C 3.433594 7.730469 3.808594 6.90625 4.40625 6.265625 C 4.3125 6.035156 3.984375 5.085938 4.5 3.820312 C 4.5 3.820312 5.300781 3.574219 7.105469 4.765625 C 7.875 4.566406 8.671875 4.460938 9.472656 4.460938 C 10.269531 4.460938 11.085938 4.566406 11.839844 4.765625 C 13.644531 3.574219 14.441406 3.820312 14.441406 3.820312 C 14.960938 5.085938 14.628906 6.035156 14.535156 6.265625 C 15.148438 6.90625 15.507812 7.730469 15.507812 8.738281 C 15.507812 12.285156 13.296875 13.0625 11.179688 13.292969 C 11.527344 13.582031 11.824219 14.132812 11.824219 15.003906 C 11.824219 16.242188 11.808594 17.234375 11.808594 17.539062 C 11.808594 17.785156 11.980469 18.074219 12.453125 17.984375 C 16.214844 16.761719 18.925781 13.308594 18.925781 9.226562 C 18.941406 4.125 14.695312 0 9.472656 0 Z M 9.472656 0 \"/></g></svg>\r\n&nbsp;[<span style=\"font-family: Open Sans; font-weight: 620; font-size: 14px;margin:-10px 0px 0px 0px;position: relative;top:-3px;left:-4px;\">Please submit any issues </span>](https://github.com/dolevshor/azure-orphan-resources/issues) <span style=\"font-family: Open Sans; font-weight: 620; font-size: 14px;margin:-10px 0px 0px 0px;position: relative;top:-3px;left:-4px;\"> with the workbook template to GitHub.</span>",
              "style": "upsell"
            },
            "conditionalVisibility": {
              "parameterName": "mainTab",
              "comparison": "isEqualTo",
              "value": "overview"
            },
            "showPin": false,
            "name": "text - Overview"
          },
          {
            "type": 1,
            "content": {
              "json": "💲 This is a sign that the resource costs money",
              "style": "info"
            },
            "conditionalVisibility": {
              "parameterName": "mainTab",
              "comparison": "isEqualTo",
              "value": "overview"
            },
            "name": "text - Overview - Cost"
          },
          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "resources\r\n| where type =~ \"microsoft.web/serverfarms\"\r\n| where resourceGroup in~ ({ResourceGroup:value})\r\n| where properties.numberOfSites == 0\r\n| summarize count_ = count() by type\r\n| extend count_ = iff(count_ == 0, 0, count_)\r\n| union (datatable(type:string, count_:long) [\"microsoft.web/serverfarms\", 0])\r\n| summarize total_count = max(count_) by type",
                    "size": 3,
                    "title": "💲",
                    "queryType": 1,
                    "resourceType": "microsoft.resourcegraph/resources",
                    "crossComponentResources": [
                      "{Subscription}"
                    ],
                    "visualization": "tiles",
                    "tileSettings": {
                      "titleContent": {
                        "columnMatch": "type",
                        "formatter": 16,
                        "formatOptions": {
                          "showIcon": true
                        }
                      },
                      "leftContent": {
                        "columnMatch": "total_count",
                        "formatter": 12,
                        "formatOptions": {
                          "palette": "auto"
                        }
                      },
                      "showBorder": true
                    }
                  },
                  "customWidth": "16.5",
                  "name": "query - Overview - App Service Plans Count"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "Resources\r\n| where type =~ \"microsoft.compute/availabilitysets\"\r\n| where resourceGroup in~ ({ResourceGroup:value})\r\n| where properties.virtualMachines == \"[]\"\r\n| where not(name endswith \"-asr\")\r\n| summarize count_ = count() by type\r\n| extend count_ = iff(count_ == 0, 0, count_)\r\n| union (datatable(type:string, count_:long) [\"microsoft.compute/availabilitysets\", 0])\r\n| summarize total_count = max(count_) by type",
                    "size": 3,
                    "title": " ",
                    "queryType": 1,
                    "resourceType": "microsoft.resourcegraph/resources",
                    "crossComponentResources": [
                      "{Subscription}"
                    ],
                    "visualization": "tiles",
                    "tileSettings": {
                      "titleContent": {
                        "columnMatch": "type",
                        "formatter": 16,
                        "formatOptions": {
                          "showIcon": true
                        }
                      },
                      "leftContent": {
                        "columnMatch": "total_count",
                        "formatter": 12,
