                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "resources\r\n| where type =~ \"microsoft.network/loadbalancers\"\r\n| where resourceGroup in~ ({ResourceGroup:value})\r\n| where properties.backendAddressPools == \"[]\" and properties.inboundNatRules == \"[]\"\r\n| summarize count_ = count() by type\r\n| extend count_ = iff(count_ == 0, 0, count_)\r\n| union (datatable(type:string, count_:long) [\"microsoft.network/loadbalancers\", 0])\r\n| summarize total_count = max(count_) by type",
