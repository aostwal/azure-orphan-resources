                          "size": 4,
                          "title": "Count by Resource Group",
                          "queryType": 1,
                          "resourceType": "microsoft.resourcegraph/resources",
                          "crossComponentResources": [
                            "{Subscription}"
                          ],
                          "visualization": "piechart",
                          "chartSettings": {
                            "showMetrics": false,
                            "showLegend": true
                          }
                        },
                        "customWidth": "25",
                        "name": "query - Subnets by Resource Group"
                      },
